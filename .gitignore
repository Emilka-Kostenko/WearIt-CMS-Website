# Ignore everything
/*

# But do not ignore the .gitignore file itself
!.gitignore
!.github/
!.github/*.*

# Do not ignore wp-content and everything inside it
!wp-content/
!wp-content/themes/**/*

wp-content/themes/twenty*/**
wp-content/themes/index.php
wp-content/plugins/index.php

# Wordfence firewall data: rewritten by the plugin on every site, differs per machine,
# and git's line-ending conversion corrupts it (fixed lengths). Never commit it.
wp-content/wflogs/


# macOS metadata
.DS_Store
**/.DS_Store